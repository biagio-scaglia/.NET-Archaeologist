# ==============================================================================
# .NET Archaeologist - Esempio di Configurazione Ambiente (.env.example)
# ==============================================================================
# Copia questo file in '.env' e inserisci le tue credenziali o endpoint locali.

# Provider AI per L'Archeologo: 'ollama' | 'openai-compatible' | 'offline'
ARCHAEOLOGIST_AI_PROVIDER=ollama

# Endpoint API (Ollama Cloud: https://ollama.com/v1 | Ollama Locale: http://localhost:11434/v1)
ARCHAEOLOGIST_API_BASE_URL=https://ollama.com/v1
VITE_ARCHAEOLOGIST_API_BASE_URL=https://ollama.com/v1

# Chiave API (necessaria per Ollama Cloud, vuota per Ollama Locale)
ARCHAEOLOGIST_API_KEY=your_api_key_here
VITE_ARCHAEOLOGIST_API_KEY=your_api_key_here

# Modello LLM consigliato (es. deepseek-v4.1-flash, gemma4:31b, llama3, qwen2.5)
ARCHAEOLOGIST_MODEL=deepseek-v4.1-flash
VITE_ARCHAEOLOGIST_MODEL=deepseek-v4.1-flash

# Timeout chiamate AI in millisecondi
ARCHAEOLOGIST_TIMEOUT_MS=45000
